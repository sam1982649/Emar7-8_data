"tables": [
{
"title": "Comparative Adjectives (صفات المقارنة)",
"headers": ["النوع", "القاعدة", "مثال"],
"rows": [
["صفات قصيرة (مقطع واحد)", "نضيف -er + than", "tall → taller than"],
["صفات تنتهي بـ -y", "نغير y إلى i ونضيف -er", "heavy → heavier than"],
["صفات ذات مقطعين تنتهي بـ -y, -er, -ow, -le", "نضيف -er + than", "pretty → prettier than, narrow → narrower than, simple → simpler than"],
["صفات طويلة (مقطعين أو أكثر)", "نستخدم more + adjective + than", "ambitious → more ambitious than"],
["صفات شاذة (غير منتظمة)", "حفظ", "good → better, bad → worse, far → farther/further"]
],
"explanation": "تستخدم صفات المقارنة للمقارنة بين شخصين أو شيئين. مع الصفات القصيرة نضيف -er، مع الصفات الطويلة نستخدم more، وبعض الصفات لها أشكال شاذة يجب حفظها.",
"examples": "Doris is taller than me. / Amanda is more ambitious than her classmates."
},
{
"title": "Simple Present - Have/Has",
"headers": ["الفاعل", "الفعل", "مثال"],
"rows": [
["I / You / We / They", "have", "I have green eyes."],
["He / She / It", "has", "She has green eyes."]
],
"explanation": "نستخدم 'have' مع (I, You, We, They) و 'has' مع (He, She, It) في المضارع البسيط للتعبير عن الملكية.",
"examples": "She has green eyes. / They have a big house."
},
{
"title": "Articles (أدوات التعريف والتنكير)",
"headers": ["أداة", "الاستخدام", "مثال"],
"rows": [
["a", "قبل الأسماء المفردة التي تبدأ بحرف ساكن", "a smart woman"],
["an", "قبل الأسماء المفردة التي تبدأ بحرف علة", "an Indian actress"],
["the", "للتعريف (شيء محدد أو معروف)", "the world's smallest woman"]
],
"explanation": "نستخدم 'a' و 'an' للتنكير، و 'the' للتعريف.",
"examples": "She is a smart woman. / She is an Indian actress."
},
{
"title": "Gerunds (المصدر - الفعل + ing)",
"headers": ["الاستخدام", "مثال"],
"rows": [
["بعد أفعال مثل: like, love, enjoy, hate, start, stop", "She likes telling jokes."],
["بعد حروف الجر", "She prevents her from studying."]
],
"explanation": "المصدر هو الفعل + ing ويستخدم كاسم، ويأتي بعد أفعال معينة أو بعد حروف الجر.",
"examples": "She likes telling jokes. / Her hair-care doesn't prevent her from studying."
},
{
"title": "Prepositions (حروف الجر)",
"headers": ["حرف الجر", "الاستخدام", "مثال"],
"rows": [
["with", "للمصاحبة", "She is with her friends."],
["of", "للتعبير عن المحتوى أو الملكية", "sense of humor, source of vitamins"],
["from", "للتعبير عن المصدر أو المنع", "prevent her from studying"],
["on", "للتعبير عن الارتداء أو الوسيلة", "puts on jeans"]
],
"explanation": "حروف الجر تربط الأسماء بالجملة. بعض الأفعال تأتي مع حروف جر محددة.",
"examples": "She has a great sense of humor. / She puts on jeans."
},
{
"title": "Conjunctions (أدوات الربط)",
"headers": ["أداة الربط", "الاستخدام", "مثال"],
"rows": [
["but", "للاستدراك (تضاد)", "She used to like dresses, but now she wears jeans."],
["because", "للسبب", "She sings loudly because she forgets."]
],
"explanation": "تستخدم أدوات الربط لربط الجمل. 'But' للاستدراك، 'Because' للسبب.",
"examples": "She used to like flowery dresses, but now she wears jeans."
},
{
"title": "Second Conditional (الجملة الشرطية من النوع الثاني)",
"headers": ["التركيب", "الاستخدام", "مثال"],
"rows": [
["If + Past Simple, would + verb", "للتعبير عن شيء غير حقيقي أو خيالي في الحاضر", "If you saw her, you would think she was older."]
],
"explanation": "تستخدم للتعبير عن مواقف غير حقيقية أو خيالية في الحاضر. تتكون من 'if' + الماضي البسيط، و 'would' + الفعل.",
"examples": "If you saw Lou in the street, you would think she was three years older."
},
{
"title": "Relative Clauses (جمل الوصل)",
"headers": ["ضمير الوصل", "الاستخدام", "مثال"],
"rows": [
["who", "للعاقل (فاعل)", "Scientists who found the remains"],
["which / that", "لغير العاقل (فاعل أو مفعول به)", "exhibits which the farmers had displayed"],
["where", "للمكان", "platform where users watch videos"]
],
"explanation": "تستخدم ضمائر الوصل لربط الجمل. 'who' للعاقل، 'which/that' لغير العاقل، 'where' للمكان.",
"examples": "Scientists who found the remains say this discovery is important."
},
{
"title": "Passive Voice - Simple Past (المبني للمجهول - الماضي البسيط)",
"headers": ["التركيب", "الاستخدام", "مثال"],
"rows": [
["was/were + past participle", "عندما يكون الفاعل هو المتلقي للفعل", "An exhibition was held last week."]
],
"explanation": "نستخدم المبني للمجهول عندما يكون الفاعل هو المتلقي للفعل وليس الفاعل. في الماضي البسيط: was/were + التصريف الثالث.",
"examples": "An exhibition was held last week."
},
{
"title": "Past Ability (القدرة في الماضي)",
"headers": ["التركيب", "الاستخدام", "مثال"],
"rows": [
["was/were able to + verb", "للتعبير عن القدرة في الماضي", "She wasn't able to participate."],
["could + verb", "للتعبير عن القدرة في الماضي", "He could find suitable clothes."]
],
"explanation": "نستخدم 'was/were able to' أو 'could' للتعبير عن القدرة في الماضي.",
"examples": "She wasn't able to participate in things they were doing."
},
{
"title": "Phrasal Verbs (الأفعال المركبة)",
"headers": ["الفعل المركب", "المعنى", "مثال"],
"rows": [
["put on", "يرتدي (ملابس)", "She puts on jeans."],
["get to know", "يتعرف على", "When she gets to know you."],
["tell apart", "يميز بين", "You can't tell them apart."]
],
"explanation": "الأفعال المركبة تتكون من فعل + حرف جر أو ظرف، ويكون معناها مختلفاً عن معنى الفعل الأصلي.",
"examples": "She just puts on jeans and a T-shirt."
},
{
"title": "Question Words (كلمات الاستفهام) - من Convert",
"headers": ["كلمة الاستفهام", "الاستخدام", "مثال"],
"rows": [
["What ... like?", "للسؤال عن الصفة", "What is Doris like?"],
["What does ... look like?", "للسؤال عن المظهر", "What does she look like?"],
["How old?", "للسؤال عن العمر", "How old is Lou?"],
["How long?", "للسؤال عن الطول أو المدة", "How long is her hair?"],
["How?", "للسؤال عن الطريقة", "How does Lou sing?"],
["Why?", "للسؤال عن السبب", "Why does he work as a farmer?"],
["Who?", "للسؤال عن الفاعل", "Who registered your names?"],
["What ... like / How?", "للسؤال عن الطقس", "What is the weather like? / How is the weather today?"]
],
"explanation": "تستخدم كلمات الاستفهام لتكوين الأسئلة. نختار كلمة الاستفهام حسب ما نريد السؤال عنه.",
"examples": "What is Doris like? / How old is Lou? / How long is her hair?"
}
]
