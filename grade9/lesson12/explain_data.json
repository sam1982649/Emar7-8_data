{
"title": "Possessive Pronouns (ضمائر الملكية)",
"headers": ["Subject Pronoun", "Possessive Pronoun", "مثال"],
"rows": [
["I", "mine", "This book is mine."],
["You", "yours", "The ball is yours."],
["He", "his", "The blue shirt is his."],
["She", "hers", "The ring is hers."],
["It", "its", "The nest is its."],
["We", "ours", "The car is ours."],
["They", "theirs", "The house is theirs."]
],
"explanation": "ضمائر الملكية تحل محل الاسم + صفة الملكية. تستخدم بمفردها ولا تتبع باسم.",
"examples": "This book is mine. / The blue car is ours."
},
{
"title": "Reflexive Pronouns (الضمائر المنعكسة)",
"headers": ["Subject Pronoun", "Reflexive Pronoun", "مثال"],
"rows": [
["I", "myself", "I looked at myself."],
["You", "yourself", "You hurt yourself."],
["He", "himself", "He made it himself."],
["She", "herself", "She looked at herself."],
["It", "itself", "The cat cleaned itself."],
["We", "ourselves", "We enjoyed ourselves."],
["They", "themselves", "They did it themselves."]
],
"explanation": "الضمير المنعكس يستخدم عندما يقوم الفاعل بالفعل على نفسه. كما يستخدم للتأكيد.",
"examples": "I introduced myself. / She looked at herself in the mirror."
},
{
"title": "Question Tags (ذيل السؤال)",
"headers": ["نوع الجملة", "التكوين", "مثال"],
"rows": [
