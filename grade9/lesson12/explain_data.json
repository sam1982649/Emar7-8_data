["your", "yours"],
["his", "his"],
["her", "hers"],
["its", "its"],
["our", "ours"],
["their", "theirs"]
],
"explanation": "صفة الملكية تتبعها اسم (my book)، أما ضمير الملكية فيحل محل الاسم.",
"examples": "This is my car. / This car is mine."
},
{
"title": "Question Tags مع الأفعال المساعدة",
"headers": ["الفعل في الجملة", "الفعل المساعد في الذيل", "مثال"],
"rows": [
["is/are/am", "isn't/aren't/am not", "She is happy, isn't she?"],
["was/were", "wasn't/weren't", "They were late, weren't they?"],
["do/does", "don't/doesn't", "You like fish, don't you?"],
["did", "didn't", "He ate lunch, didn't he?"],
["have/has", "haven't/hasn't", "They have left, haven't they?"],
["can/could", "can't/couldn't", "You can swim, can't you?"]
],
"explanation": "نستخدم نفس الفعل المساعد في الذيل، وإذا لم يوجد نستخدم do/does/did.",
"examples": "You like tea, don't you? / She can sing, can't she?"
},
