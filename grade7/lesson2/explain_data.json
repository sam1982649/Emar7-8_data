"tables": [
{
"title": "Simple Past Tense - Regular Verbs (الماضي البسيط - الأفعال المنتظمة)",
"headers": ["Base Form", "Past Tense", "Rule"],
"rows": [
["visit", "visited", "نضيف ed"],
["play", "played", "نضيف ed"],
["study", "studied", "نحول y إلى ied"],
["stop", "stopped", "نضاعف الحرف الأخير + ed"],
["cook", "cooked", "نضيف ed"]
],
"explanation": "لتكوين الماضي البسيط للأفعال المنتظمة نضيف (ed) إلى نهاية الفعل. هناك قواعد إملائية خاصة لبعض الأفعال.",
"examples": "I visited Cairo last year.\nLast night I played my guitar loudly.\nMy mother didn't cook because she was tired."
},
{
"title": "Simple Past Tense - Irregular Verbs (الماضي البسيط - الأفعال غير المنتظمة)",
"headers": ["Base Form", "Past Tense"],
"rows": [
["eat", "ate"],
["go", "went"],
["have", "had"],
["sleep", "slept"],
["teach", "taught"],
["feel", "felt"],
["become", "became"],
["meet", "met"],
["spend", "spent"]
],
"explanation": "الأفعال غير المنتظمة تغير شكلها بالكامل في الماضي البسيط. يجب حفظها كما هي. لا توجد قاعدة ثابتة لها.",
"examples": "He ate so many clouds.\nThey went to school yesterday.\nShe felt terrible.\nShe spent hours crying."
},
{
"title": "Simple Past - Negative (النفي في الماضي البسيط)",
"headers": ["Type", "Form", "Example"],
"rows": [
["مع الأفعال العادية", "didn't + المصدر", "I didn't play football."],
["مع الأفعال غير المنتظمة", "didn't + المصدر", "He didn't know how to make friends."],
["مع فعل to be", "wasn't / weren't", "She wasn't happy."]
],
"explanation": "لنفي الماضي البسيط نستخدم (didn't) مع الفعل في المصدر (base form). أما مع فعل to be فنستخدم (wasn't) للمفرد و (weren't) للجمع.",
"examples": "The pupils didn't play in the playground yesterday.\nMy mother didn't cook because she was tired.\nThey weren't satisfied with the answer."
},
{
"title": "Simple Past - Questions (السؤال في الماضي البسيط)",
"headers": ["Type", "Form", "Example"],
"rows": [
["مع الأفعال العادية", "Did + الفاعل + المصدر؟", "Did John want to go to the museum?"],
["مع فعل to be", "Was/Were + الفاعل؟", "Was Susan busy cleaning the whole house?"],
["مع كلمات الاستفهام", "Wh- + did + الفاعل + المصدر؟", "What did you eat?"]
],
"explanation": "لتكوين السؤال في الماضي البسيط نضع (Did) قبل الفاعل، والفعل في المصدر. أما مع فعل to be فنضع (Was/Were) قبل الفاعل.",
"examples": "Did John want to go to the museum?\nWas Susan busy cleaning the whole house?\nWhy did the employees stay late last night?"
},
{
"title": "Conjunctions (أدوات الربط)",
"headers": ["Conjunction", "Usage", "Example"],
"rows": [
["so", "النتيجة", "He ate so many clouds, so the rain disappeared."],
["because", "السبب", "My mother didn't cook because she was tired."],
["but", "التعارض", "The sky was cloudy, but it didn't rain."]
],
"explanation": "أدوات الربط تستخدم لربط الجمل. 'so' للنتيجة، 'because' للسبب، 'but' للتعارض.",
"examples": "He ate so many clouds, so the rain disappeared.\nMy mother didn't cook because she was tired.\nThe sky was cloudy, but it didn't rain."
},
{
"title": "Gerund as Subject (المصدر كفاعل)",
"headers": ["Form", "Example"],
"rows": [
["Verb + ing", "Eating clouds caused Soppo stomachache."],
["Verb + ing", "Smoking is the enemy of our lungs."]
],
"explanation": "يمكن استخدام الفعل المضاف إليه (ing) كفاعل في الجملة. يأتي الفعل بصيغة المصدر ويأخذ تصريف المفرد.",
"examples": "Eating clouds always caused Soppo stomachache.\nSmoking is the enemy of our lungs."
},
{
"title": "Infinitive of Purpose (المصدر للغرض)",
"headers": ["Form", "Example"],
"rows": [
["to + verb", "Soppo decided to help people."],
["to + verb", "Everyone came to console her."]
],
"explanation": "نستخدم 'to' + المصدر للتعبير عن الغرض أو الهدف من الفعل.",
"examples": "Soppo decided to help people.\nEveryone came and tried to console her."
},
{
"title": "Object Pronouns (ضمائر المفعول به)",
"headers": ["Subject Pronoun", "Object Pronoun", "Example"],
"rows": [
["I", "me", "She helped me."],
["he", "him", "Eating clouds made him cry."],
["she", "her", "Everyone tried to console her."],
["they", "them", "I gave them a present."]
],
"explanation": "ضمائر المفعول به تأتي بعد الفعل أو حرف الجر. نستخدمها بدلاً من الاسم لتجنب التكرار.",
"examples": "Eating clouds made him cry.\nEveryone came and tried to console her.\nStudents rely on them."
},
{
"title": "Relative Pronoun - Who (ضمير الوصل)",
"headers": ["Pronoun", "Usage", "Example"],
"rows": [
["who", "للعاقل (فاعل)", "Judi was the only one who did not receive a present."]
],
"explanation": "نستخدم 'who' للعاقل كفاعل في جملة الوصل. تعود على الشخص المذكور.",
"examples": "Judi was the only one who did not receive a present.\nThe teacher who provided information."
},
{
"title": "Prepositions (حروف الجر)",
"headers": ["Preposition", "Usage", "Example"],
"rows": [
["with", "مع (satisfied)", "They weren't satisfied with the answer."],
["out", "انقطاع (went out)", "The electricity went out."]
],
"explanation": "حروف الجر تربط الكلمات في الجملة. بعض الأفعال تأتي مع حروف جر محددة.",
"examples": "They weren't satisfied with the answer.\nThe electricity went out during the storm."
}
]
