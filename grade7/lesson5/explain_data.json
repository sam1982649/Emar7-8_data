{
"title": "Present Perfect Tense (المضارع التام)",
"headers": ["Usage", "Example"],
"rows": [
["حدث بدأ في الماضي وما زال مستمراً", "I have lived here since 2010."],
["حدث وقع في الماضي وله تأثير على الحاضر", "She has lost her keys."],
["حدث وقع في وقت غير محدد في الماضي", "I have already eaten."],
["خبرة أو تجربة", "Have you ever visited London?"]
],
"explanation": "يتكون المضارع التام من (have/has + التصريف الثالث للفعل). يستخدم للتعبير عن حدث وقع في الماضي وله علاقة بالحاضر.",
"examples": "I have just bought a new laptop.\nSami hasn't phoned me yet.\nHave you ever climbed the Eiffel Tower?"
},
{
"title": "Present Perfect - Signal Words (الكلمات الدالة)",
"headers": ["Signal Word", "Translation", "Example"],
"rows": [
["already", "بالفعل", "I have already eaten."],
["yet", "بعد (في النفي)", "I haven't eaten yet."],
["just", "للتّو", "I have just arrived."],
["ever", "في أي وقت مضى", "Have you ever been there?"],
["never", "أبداً", "I have never been there."],
["since", "منذ", "I have lived here since 2010."],
["recently", "مؤخراً", "I have recently started."]
],
"explanation": "الكلمات الدالة تساعد في تحديد زمن المضارع التام. 'already' و 'just' في المثبت، 'yet' في النفي، 'ever' في السؤال، 'never' في النفي، 'since' و 'recently' مع المدة الزمنية.",
"examples": "I have just bought a new laptop.\nSami hasn't phoned me yet.\nHave you ever climbed the Eiffel Tower?"
},
